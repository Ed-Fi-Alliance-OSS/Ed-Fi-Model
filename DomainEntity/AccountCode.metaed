Domain Entity AccountCode
    documentation "The set of account codes defined by an education organization for a fiscal year."
    shared string AccountCodeIdentifier named AccountCode
        documentation "An account code defined for the education accounting system by the education organization."
        is part of identity
    descriptor AccountClassification
        documentation "The type of account code associated with the account."
        is part of identity
    domain entity EducationOrganization
        documentation "A reference to the education organization for which the codes are applicable."
        is part of identity
    integer FiscalYear
        documentation "The financial accounting year."
        is part of identity
    string AccountCodeDescription
        documentation "A description of the account code."
        is optional
        max length 1024
