Domain Entity Contact
    documentation "This entity represents a contact of a student, such as a parent, guardian or caretaker."
    shared string UniqueId
        documentation "A unique alphanumeric code assigned to a contact."
        is part of identity
        role name Contact
        is queryable field
    inline common Name
        documentation "Full legal name of the person."
        is required
        is queryable field
    common OtherName
        documentation "Other names (e.g., alias, nickname, previous legal name) associated with a person."
        is optional collection
        is queryable field
    descriptor Sex
        deprecated "The descriptor will be removed from the Ed-Fi core with Data Standard v7.0"
        documentation "A person's birth sex."
        is optional
        is queryable field
    shared string GenderIdentity
        documentation "The gender the contact identifies themselves as."
        is optional
    common Address
        documentation "Contact's address, if different from the student address."
        is optional collection
        is queryable field
    common InternationalAddress
        documentation "The set of elements that describes an international address."
        is optional collection
    common Telephone
        documentation "The 10-digit telephone number, including the area code, for the person."
        is optional collection
        is queryable field
    common ElectronicMail
        documentation "The numbers, letters, and symbols used to identify an electronic mail (e-mail) user within the network to which the individual or organization belongs."
        is optional collection
        is queryable field
    shared string IdentificationCode named LoginId
        documentation "The login ID for the user; used for security access control interface."
        is optional
    domain entity EducationOrganization
        documentation "Provide user information to lookup and link to an existing educational organization record in the receiving system."
        is queryable only
    common Language
        documentation "The language(s) the individual uses to communicate. It is strongly recommended that entries use only ISO 639-2 language codes."
        is optional collection
    domain entity Person
        documentation "Relates the contact to a generic person."
        is optional
    descriptor LevelOfEducation
        documentation "The extent of formal instruction an individual has received (e.g., the highest grade in school completed or its equivalent or the highest degree received)."
        is optional
        role name HighestCompleted
