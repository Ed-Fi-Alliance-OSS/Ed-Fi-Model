Domain Entity ObjectiveAssessment
    documentation "This entity represents subtests that assess specific learning objectives."
    shared string IdentificationCode
        documentation "A unique number or alphanumeric code assigned to an objective assessment by a school, school system, a state, or other agency or entity."
        is part of identity
    decimal MaxRawScore
        documentation "The maximum raw score achievable across all assessment items that are correct and scored at the maximum."
        is optional
        total digits 15
        decimal places 5
    common AssessmentPerformanceLevel
        documentation "Definition of the performance levels and the associated cut scores. Three styles are supported: 1. Specification of performance level by minimum and maximum score, 2. Specification of performance level by cut score, using only minimum score, 3. Specification of performance level without any mapping to scores"
        is optional collection
    percent PercentOfAssessment
        documentation "The percentage of the assessment that tests this objective."
        is optional
    shared string Nomenclature
        documentation "Reflects the specific nomenclature used for this level of objective assessment."
        is optional
    shared string Description
        documentation "The description of the objective assessment (e.g., vocabulary, measurement, or geometry)."
        is optional
    domain entity AssessmentItem
        documentation "References individual test items, if appropriate."
        is optional collection
        role name AssessmentItem
        merge AssessmentItem.Assessment with Assessment
    domain entity LearningStandard
        documentation "Learning standard tested by this objective assessment."
        is optional collection
    domain entity ObjectiveAssessment
        documentation "Provide user information to lookup and link to the parent objective assessment containing this objective assessment."
        is optional collection
        role name Parent
        merge ParentObjectiveAssessment.Assessment with Assessment
    domain entity Assessment
        documentation "Provide user information to lookup and link to an existing assessment."
        is part of identity
    common AssessmentScore
        documentation "Definition of the scores to be expected from this objective assessment."
        is optional collection
    descriptor AcademicSubject
        documentation "The subject area of the objective assessment."
        is optional
