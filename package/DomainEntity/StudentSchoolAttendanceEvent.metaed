Domain Entity StudentSchoolAttendanceEvent
    documentation "This event entity represents the recording of whether a student is in attendance for a school day."
    inline common AttendanceEvent
        documentation "Details of the attendance event."
        is required
    domain entity Student
        documentation "Relates the student associated with the attendance event."
        is part of identity
    domain entity School
        documentation "Relates the school associated with the attendance event."
        is part of identity
    domain entity Session
        documentation "Relates the session associated with the attendance event."
        is part of identity
        merge Session.School with School
    shared integer AttendanceEventDuration named SchoolAttendanceDuration
        documentation "The duration in minutes of the school attendance event."
        is optional
    time ArrivalTime
        documentation "The time of day the student arrived for the attendance event in ISO 8601 format."
        is optional
    time DepartureTime
        documentation "The time of day the student departed for the attendance event in ISO 8601 format."
        is optional
