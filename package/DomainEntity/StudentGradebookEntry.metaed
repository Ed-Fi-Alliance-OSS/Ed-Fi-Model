Domain Entity StudentGradebookEntry
    documentation "This entity holds a student's grade or competency level for a gradebook entry."
    domain entity GradebookEntry
        documentation "The gradebook entry associated with the student grade or score."
        is part of identity
    domain entity Student
        documentation "The student associated with the student gradebook entry."
        is part of identity
    descriptor CompetencyLevel
        documentation "The competency level assessed for the student for the referenced learning objective."
        is optional
    date DateFulfilled
        documentation "The date an assignment was turned in or the date of an assessment."
        is optional
    time TimeFulfilled
        documentation "The time an assignment was turned in on the date fulfilled."
        is optional
    shared string DiagnosticStatement
        documentation "A statement provided by the teacher that provides information in addition to the grade or assessment score."
        is optional
    shared decimal NumericGrade named PointsEarned
        documentation "The points earned for the submission. With extra credit, the points earned may exceed the max points."
        is optional
    shared string GradeEarned named LetterGradeEarned
        documentation "A final or interim (grading period) indicator of student performance in a class as submitted by the instructor."
        is optional
    shared decimal NumericGrade named NumericGradeEarned
        documentation "A final or interim (grading period) indicator of student performance in a class as submitted by the instructor."
        is optional
    descriptor SubmissionStatus
        documentation "The status of the student's submission."
        is optional
    descriptor AssignmentLateStatus
        documentation "Status of whether the assignment was submitted after the due date and/or marked as."
        is optional
    date DateCompleted
        documentation "The date that the assignment was completed."
        is optional
    bool AssignmentPassed
        documentation "Indication of whether the assignment was passed or not."
        is optional
