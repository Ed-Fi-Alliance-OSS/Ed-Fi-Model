Domain Entity Path
    documentation "A scheme for achieving milestones organized by phases for students to follow and be tracked against."
    domain entity EducationOrganization
        documentation "A reference to the education organization associated with the path of study."
        is part of identity
    shared string PathName
        documentation "The name of the path of study."
        is part of identity
    domain entity GraduationPlan
        documentation "The graduation plan associated with the path of study."
        is optional
