Domain Entity StudentSectionAttendanceEvent
    documentation "This event entity represents the recording of whether a student is in attendance for a section."
    inline common AttendanceEvent
        documentation "Details of the attendance event."
        is required
    domain entity Student
        documentation "Relates the student associated with the attendance event."
        is part of identity
    domain entity Section
        documentation "Relates the section associated with the attendance event."
        is part of identity
    shared integer AttendanceEventDuration named SectionAttendanceDuration
        documentation "The duration in minutes of the section attendance event."
        is optional
    time ArrivalTime
        documentation "The time of day the student arrived for the attendance event in ISO 8601 format."
        is optional
    time DepartureTime
        documentation "The time of day the student departed for the attendance event in ISO 8601 format."
        is optional
    domain entity ClassPeriod
        documentation "The class period(s) to which the section attendance event applies."
        is optional collection
        merge ClassPeriod.School with Section.CourseOffering.Session.School
