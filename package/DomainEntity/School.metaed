Domain Entity School based on EducationOrganization
    documentation "This entity represents an educational organization that includes staff, students and candidates who participate in classes and educational activity groups, inclusive of school in a post secondary institution."
    integer SchoolId
        documentation "The identifier assigned to a school. It must be distinct from any other identifier assigned to educational organizations, such as a LocalEducationAgencyId, to prevent duplication."
        renames identity property EducationOrganizationId
        is queryable field
        min value big
    descriptor GradeLevel
        documentation "The grade levels served at the school."
        is required collection
    descriptor SchoolCategory
        documentation "The one or more categories of school."
        is optional collection
    descriptor SchoolType
        documentation "The type of education institution as classified by its primary focus."
        is optional
    descriptor CharterStatus
        documentation "A school or agency providing free public elementary or secondary education to eligible students under a specific charter granted by the state legislature or other appropriate authority and designated by such authority to be a charter school."
        is optional
    descriptor TitleIPartASchoolDesignation
        documentation "Denotes the Title I Part A designation for the school."
        is optional
    descriptor MagnetSpecialProgramEmphasisSchool
        documentation "A school that has been designed: 1) to attract students of different racial/ethnic backgrounds for the purpose of reducing, preventing, or eliminating racial isolation; and/or 2) to provide an academic or social focus on a particular theme (e.g., science/math, performing arts, gifted/talented, or foreign language)."
        is optional
    descriptor AdministrativeFundingControl
        documentation "The type of education institution as classified by its funding source, for example public or private."
        is optional
    descriptor InternetAccess
        documentation "The type of Internet access available."
        is optional
    domain entity LocalEducationAgency
        documentation "LEA of which the School is an organizational component."
        is optional
    descriptor CharterApprovalAgencyType
        documentation "The type of agency that approved the establishment or continuation of a charter school."
        is optional
    enumeration SchoolYear
        documentation "The school year in which a charter school was initially approved."
        is optional
        role name CharterApproval
    descriptor FederalLocaleCode
        documentation "The federal locale code associated with an education organization."
        is optional
    domain entity PostSecondaryInstitution
        documentation "The postsecondary institution or university associated as an organization component for the school, if applicable"
        is optional
    bool ImprovingSchool
        documentation "An indication of whether a school is identified as an improving school."
        is optional
    descriptor AccreditationStatus
        documentation "The accreditation status for an education preparation provider."
        is optional