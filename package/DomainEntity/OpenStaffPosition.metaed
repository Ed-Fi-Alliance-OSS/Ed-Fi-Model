Domain Entity OpenStaffPosition
    documentation "This entity represents an open staff position that the education organization is seeking to fill."
    shared string PositionIdentifier
        documentation "Identifier assigned to the position to be filled.  Typically a number assigned by Human Resources that is associated with the specific position." 
        is part of identity
    domain entity EducationOrganization
        documentation "The education organization with the open staff position."
        is part of identity
    descriptor StaffClassification
        documentation "The titles of employment, official status, or rank of education staff."
        is required
    common PositionVacancy
        documentation "The set of elements that describe the reason for vacancy and the date of the vacancy."
        is optional
    descriptor SchoolCategory named InstructionalGradeRange
        documentation "The category of school levels of the teaching position. For example: High School, Middle School, Elementary School."
        is optional collection
    descriptor InstructionalSubject
        documentation "The Academic subject of instruction for that position."
        is optional collection
    descriptor ProgramAssignment
        documentation "The name of the program for which the open staff position will be assigned."
        is optional
    shared string PositionTitle
        documentation "The descriptive name of an individual's position."
        is optional
    enumeration SchoolYear
        documentation "The identifier for the school year for which the open staff position is seeking to fill."
        is optional
    shared decimal FullTimeEquivalency
        documentation "The ratio between the hours of work expected in a position and the hours of work normally expected in a full-time position in the same setting."
        is optional
    shared decimal CompensationPackageAmount named MaxSalary
        documentation "The maximum salary or wage a person is paid before deductions (excluding differentials) but including annuities."
        is optional
    shared decimal CompensationPackageAmount named MinSalary
        documentation "The minimum salary or wage a person is paid before deductions (excluding differentials) but including annuities."
        is optional
    descriptor FundingSource
        documentation "The funding source for the open staff position."
        is optional
    bool HighNeedAcademicSubject
        documentation "Indicator as to whether the open staff position is filling a high-need subject area designated as a teacher shortage that may be eligible for special grants, aid, or compensation."
        is optional
    descriptor Term
        documentation "The first term for the session during the school year for which the open staff position is seeking to fill."
        is optional
    shared decimal CompensationPackageAmount named TotalBudgeted
        documentation "The fully loaded cost budgeted for this teacher, including salary."
        is optional