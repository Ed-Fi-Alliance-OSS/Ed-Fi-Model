Domain Entity Credential
    documentation "The legal document giving authorization to perform teaching assignment services."
    shared string IdentificationCode named CredentialIdentifier
        documentation "Identifier or serial number assigned to the credential."
        is part of identity
    descriptor StateAbbreviation
        documentation "The abbreviation for the name of the state (within the United States) or extra-state jurisdiction in which a license/credential was issued."
        is part of identity
        role name StateOfIssue
    shared string URI named Namespace
        documentation "The namespace for the credential."
        is required
    descriptor CredentialType
        documentation "An indication of the category of the credential a person holds."
        is required
    date IssuanceDate
        documentation "The month, day, and year on which an active credential was issued to a person."
        is required
    descriptor CredentialField
        documentation "The field of certification for the credential."
        is optional   
    date EffectiveDate
        documentation "The month, day, and year on which an active credential held by a person was issued.  Note: Date interpretation may vary. Ed-Fi recommends inclusive dates, but states may define dates as inclusive or exclusive. For calculations, align with local guidelines."
        is optional
    date ExpirationDate
        documentation "The month, day, and year on which an active credential held by a person will expire.  Note: Date interpretation may vary. Ed-Fi recommends inclusive dates, but states may define dates as inclusive or exclusive. For calculations, align with local guidelines."
        is optional
    descriptor TeachingCredential
        documentation "An indication of the category of a legal document giving authorization to perform teaching assignment services."
        is optional
    descriptor TeachingCredentialBasis
        documentation "An indication of the pre-determined criteria for granting the teaching credential that a person holds."
        is optional
    descriptor GradeLevel
        documentation "The grade level(s) certified for teaching."
        is optional collection
    descriptor AcademicSubject
        documentation "The academic subjects to which the credential pertains."
        is optional collection        
    shared string CredentialEndorsement
        documentation "The endorsements that are attached to teaching certificates and indicate areas of specialization."
        is optional collection   
    shared string CertificationTitle
        documentation "The title of the certification obtained by the person."
        is optional
    domain entity Certification
        documentation "Reference to the certification associated with the person's credential."
        is optional
        role name Certification
    descriptor CertificationRoute
        documentation "The process, program, or pathway used to obtain certification."
        is optional
    bool BoardCertificationIndicator
        documentation "Indicator that the credential was granted under the authority of a national board certification."
        is optional
    descriptor CredentialStatus
        documentation "The current status of the credential."
        is optional
    date CredentialStatusDate
        documentation "The month, day, and year on which the credential status was effective. Note: Date interpretation may vary. Ed-Fi recommends inclusive dates, but states may define dates as inclusive or exclusive. For calculations, align with local guidelines."
        is optional
    domain entity Person
        documentation "The person who obtained and is holding the credential."
        is optional
    domain entity StudentAcademicRecord
        documentation "Reference to the person's student academic records for the school(s) with which the credential is associated."
        is optional collection
    descriptor EducatorRole
        documentation "The specific roles or positions within an organization that the credential is intended to authorize, typically associated with service and administrative certifications."
        is optional