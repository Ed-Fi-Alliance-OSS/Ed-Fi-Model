Domain Entity StudentInterventionAttendanceEvent
    documentation "This event entity represents the recording of whether a student is in attendance for an intervention service."
    inline common AttendanceEvent
        documentation "Details of the attendance event."
        is required
    domain entity Student
        documentation "Relates the student associated with the attendance event."
        is part of identity
    domain entity Intervention
        documentation "Relates the intervention associated with the attendance event."
        is part of identity
    shared integer AttendanceEventDuration named InterventionDuration
        documentation "The duration in minutes of the intervention attendance event."
        is optional
