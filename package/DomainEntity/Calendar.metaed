Domain Entity Calendar
    documentation "A set of dates associated with an organization."
    shared string IdentificationCode named CalendarCode
        documentation "The identifier for the calendar."
        is part of identity
    descriptor CalendarType
        documentation "Indicates the type of calendar."
        is required
    descriptor GradeLevel
        documentation "Indicates the grade level associated with the calendar."
        is optional collection
    domain entity School
        documentation "Reference to the school associated with the calendar."
        is part of identity
    enumeration SchoolYear
        documentation "The identifier for the school year associated with the calendar."
        is part of identity
