Abstract Entity EducationOrganization
    documentation "This entity represents any public or private institution, organization, or agency that provides instructional or support services to students or staff at any level."
    integer EducationOrganizationId
        documentation "The identifier assigned to an education organization."
        is part of identity
        is queryable field
        min value big
    shared string NameOfInstitution
        documentation "The full, legally accepted name of the institution."
        is required
        is queryable field
    shared string NameOfInstitution
        documentation "A short name for the institution."
        is optional
        role name Short
    descriptor EducationOrganizationCategory
        documentation "The classification of the education agency within the geographic boundaries of a state according to the level of administrative and operational control granted by the state."
        is optional collection
        is queryable field
    common Address
        documentation "The set of elements that describes an address for the education entity, including the street address, city, state, ZIP code, and ZIP code + 4."
        is optional collection
    common InternationalAddress
        documentation "The set of elements that describes the international physical location of the education entity."
        is optional collection
    common InstitutionTelephone
        documentation "The 10-digit telephone number, including the area code, for the education entity."
        is optional collection
    shared string URI named WebSite
        documentation "The public web site address (URL) for the education organization."
        is optional
    descriptor OperationalStatus
        documentation "The current operational status of the education organization (e.g., active, inactive)."
        is optional
    common EducationOrganizationIndicator
        documentation "An indicator or metric of an education organization."
        is optional collection
