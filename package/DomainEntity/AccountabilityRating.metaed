Domain Entity AccountabilityRating
    documentation "An accountability rating for a school or district."
    domain entity EducationOrganization
        documentation "Relates the accountability rating to an education organization."
        is part of identity
    shared string RatingTitleType named RatingTitle
        documentation "The title of the rating."
        is part of identity
    shared string Rating
        documentation "An accountability rating level, designation, or assessment."
        is required
    date RatingDate
        documentation "The date the rating was awarded."
        is optional
    enumeration SchoolYear
        documentation "The school year for which the accountability rating is assessed."
        is part of identity
    shared string RatingOrganization
        documentation "The organization that assessed the rating."
        is optional
    shared string RatingProgram
        documentation "The program associated with the accountability rating (e.g., NCLB, AEIS)."
        is optional