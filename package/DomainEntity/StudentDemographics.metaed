Domain Entity StudentDemographics
documentation "The demographic information associated to a student."
    domain entity Student
        documentation "A reference to the student."
        is part of identity
    domain entity EducationOrganization
        documentation "A reference ot the education organization representing the context of the student information."
        is part of identity
    descriptor Sex
        documentation "The student's birth sex as reported to the education organization."
        is optional
    shared string GenderIdentity
        documentation "The student's gender as last reported to the education organization."
        is optional
    descriptor Race
        documentation "The general racial category which most clearly reflects the individual's recognition of his or her community or with the which the individual most identifies as last reported to the education organization. The data model allows for multiple entries so that each individual can specify all appropriate races."
        is optional collection
    bool HispanicLatinoEthnicity
        deprecated "This element is scheduled for removal by 2029. Users of this element are advised to use Race."
        documentation "An indication that the individual traces his or her origin or descent to Mexico, Puerto Rico, Cuba, Central, and South America, and other Spanish cultures, regardless of race, as last reported to the education organization. The term ""Spanish origin"", can be used in addition to ""Hispanic or Latino""."
        is optional
    descriptor AncestryEthnicOrigin
        documentation "The original peoples or cultures with which the individual identifies."
        is optional collection
    inline common Citizenship
        documentation "Contains information relative to U.S. citizenship status and its associated probationary documentation."
        is optional
    descriptor TribalAffiliation
        documentation "An American Indian tribe with which the student is affiliated as last reported to the education organization."
        is optional collection
    descriptor LimitedEnglishProficiency
        documentation "An indication that the student has been identified as limited English proficient by the Language Proficiency Assessment Committee (LPAC), or English proficient."
        is optional
    common Language
        documentation "The language(s) the individual uses to communicate. It is strongly recommended that entries use only ISO 639-3 languages codes."
        is optional collection
    common Disability
        documentation "The disability condition(s) that best describes an individual's impairment, as determined by evaluation(s) conducted by the education organization."
        is optional collection
    descriptor SupporterMilitaryConnection
        documentation "Military connection of the person/people whom the student is a dependent of."
        is optional
    date BeginDate
        documentation "Month, day, and year of the first day the information is valid."
        is optional
    date EndDate
        documentation "Month, day, and year of the last day the information is valid."
        is optional