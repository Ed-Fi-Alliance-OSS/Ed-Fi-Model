Domain Entity Session
    documentation "A specific designated unit of time during which instruction is provided, grades are reported and academic credits are awarded to students (whenever applicable). Sessions serve as organized segments of the academic year and can be interrupted by vacations or other events."
    allow primary key updates
    shared string IdentificationCode named SessionName
        documentation "The identifier for the calendar for the academic session."
        is part of identity
        is queryable field
    enumeration SchoolYear
        documentation "The identifier for the school year."
        is part of identity
        is queryable field
    date BeginDate
        documentation "Month, day, and year of the first day of the session.  Note: Date interpretation may vary. Ed-Fi recommends inclusive dates, but states may define dates as inclusive or exclusive. For calculations, align with local guidelines."
        is required
    date EndDate
        documentation "Month, day and year of the last day of the session.  Note: Date interpretation may vary. Ed-Fi recommends inclusive dates, but states may define dates as inclusive or exclusive. For calculations, align with local guidelines."
        is required
    descriptor Term
        documentation "A descriptor value to indicate the term that the session is associated with."
        is required
        is queryable field
    shared integer TotalInstructionalDays
        documentation "The total number of instructional days in the school calendar."
        is required
    domain entity School
        documentation "Relates the session to the school."
        is part of identity
        is queryable field
    domain entity GradingPeriod
        documentation "Grading periods associated with the session."
        is optional collection
        merge GradingPeriod.SchoolYear with SchoolYear
        merge GradingPeriod.School with School
    domain entity AcademicWeek
        documentation "The academic weeks associated with the school year."
        is optional collection
