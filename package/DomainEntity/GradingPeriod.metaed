Domain Entity GradingPeriod
    documentation "This entity represents the time span for which grades are reported."
    domain entity School
        documentation "Provide user information to lookup and link to an existing school record."
        is part of identity
    descriptor GradingPeriod
        documentation "The state's name of the period for which grades are reported."
        is part of identity
    shared string GradingPeriodName
        documentation "The school's descriptive name of the grading period."
        is part of identity
    integer PeriodSequence
        documentation "The sequential order of this period relative to other periods."
        is optional
    enumeration SchoolYear
        documentation "The identifier for the grading period school year."
        is part of identity
    date BeginDate
        documentation "Month, day, and year of the first day of the grading period.  Note: Date interpretation may vary. Ed-Fi recommends inclusive dates, but states may define dates as inclusive or exclusive. For calculations, align with local guidelines."
        is required
    date EndDate
        documentation "Month, day, and year of the last day of the grading period.  Note: Date interpretation may vary. Ed-Fi recommends inclusive dates, but states may define dates as inclusive or exclusive. For calculations, align with local guidelines."
        is required
    shared integer TotalInstructionalDays
        documentation "Total days available for educational instruction during the grading period."
        is required
