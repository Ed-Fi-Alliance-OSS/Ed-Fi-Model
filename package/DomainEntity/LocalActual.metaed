Domain Entity LocalActual
    documentation "The set of local education agency or charter management organization expense or revenue amounts."
    domain entity LocalAccount
        documentation "References the local account with which the local actual is associated."
        is part of identity
    date AsOfDate
        documentation "The date of the reported amount for the account."
        is part of identity
        is queryable field
    currency Amount
        documentation "Current balance for the account."
        is required
    descriptor FinancialCollection
        documentation "The accounting period or grouping for which the amount is collected."
        is optional
