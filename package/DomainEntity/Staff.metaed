Domain Entity Staff
    documentation "This entity represents an individual who performs specified activities for any public or private education institution or agency that provides instructional and/or support services to students or staff at the early childhood level through high school completion."
    shared string UniqueId
        documentation "A unique alphanumeric code assigned to a staff."
        is part of identity
        role name Staff
        is queryable field
    inline common Name
        documentation "Full legal name of the person."
        is required
        is queryable field
    common OtherName
        documentation "Other names associated with a person."
        is optional collection
        is queryable field
    date BirthDate
        documentation "The month, day, and year on which an individual was born."
        is optional
        is queryable field
    descriptor LevelOfEducation
        documentation "The extent of formal instruction an individual has received (e.g., the highest grade in school completed or its equivalent or the highest degree received)."
        is optional
        role name HighestCompleted
    shared decimal NumberOfYears named YearsOfPriorProfessionalExperience
        documentation "The total number of years that an individual has previously held a similar professional position in one or more education institutions prior to the current school year."
        is optional
    shared decimal NumberOfYears named YearsOfPriorTeachingExperience
        documentation "The total number of years that an individual has previously held a teaching position in one or more education institutions prior to the current school year."
        is optional
    shared string IdentificationCode named LoginId
        documentation "The login ID for the user; used for security access control interface."
        is optional
    bool HighlyQualifiedTeacher
        documentation "An indication of whether a teacher is classified as highly qualified for his/her assignment according to state definition. This attribute indicates the teacher is highly qualified for ALL Sections being taught."
        is optional
    domain entity EducationOrganization
        documentation "Provide user information to lookup and link to an existing educational organization record in the receiving system."
        is queryable only
    common Recognition
        documentation "Recognitions given to the staff for accomplishments in a co-curricular or extracurricular activity."
        is optional collection
    domain entity Credential
        documentation "The legal document giving authorization to perform teaching assignment services."
        is optional collection
    domain entity Person
        documentation "Relates the staff to a generic person."
        is optional
    descriptor AcademicSubject
        documentation "The academic subject(s) in which the staff is deemed to be ""highly qualified""."
        is optional collection
        role name HighlyQualified
    common EducatorResearch
        documentation "The educator preparation provider faculty that instruct teacher candidates in content area or pedagogy."
        is optional
    domain entity EducatorPreparationProgram
        documentation "The educator preparation program(s) completed by the teacher."
        is optional collection
    domain entity OpenStaffPosition
        documentation "Reference to the open staff position filled by the staff."
        is optional        
