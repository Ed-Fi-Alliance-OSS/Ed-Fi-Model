Association StudentContactAssociation
    documentation "This association relates students to their parents, guardians, or caretakers."
    domain entity Student
        documentation "The student associated with the contact."
    domain entity Contact
        documentation "The contact associated with the student."
    descriptor Relation
        documentation "The nature of an individual's relationship to a student, primarily used to capture family relationships."
        is optional
    bool PrimaryContactStatus
        documentation "Indicator of whether the person is a primary contact for the student."
        is optional
    bool LivesWith
        documentation "Indicator of whether the student lives with the associated contact."
        is optional
    bool EmergencyContactStatus
        documentation "Indicator of whether the person is a designated emergency contact for the student."
        is optional
    integer ContactPriority
        documentation "The numeric order of the preferred sequence or priority of contact."
        is optional
    shared string ContactRestrictions
        documentation "Restrictions for student and/or teacher contact with the individual (e.g., the student may not be picked up by the individual)."
        is optional
    bool LegalGuardian
        documentation "Indicator of whether the person is a legal guardian for the student."
        is optional
