Common StudentAssessmentItem
    documentation "This entity represents the student's response to an assessment item and the item-level scores such as correct, incorrect, or met standard."
    shared string AssessmentResponse
        documentation "A student's response to a stimulus on a test."
        is optional
    shared string Description named DescriptiveFeedback
        documentation "The formative descriptive feedback that was given to a student in response to the results from a scored/evaluated assessment item."
        is optional
    descriptor ResponseIndicator
        documentation "Indicator of the response."
        is optional
    descriptor AssessmentItemResult
        documentation "The analyzed result of a student's response to an assessment item."
        is required
    decimal RawScoreResult
        documentation "A meaningful raw score of the performance of a student on an assessment item."
        is optional
        total digits 15
        decimal places 5
    duration TimeAssessed
        documentation "The overall time that a student actually spent on the assessment item expressed in minutes."
        is optional
    domain entity AssessmentItem
        documentation "The assessment item responded to by the student."
        is part of identity
    integer ItemNumber
        documentation "The test question number for this student's test item."
        is optional
