Common PossibleResponse
    documentation "A possible response to an assessment item."
    shared string ResponseValue
        documentation "The response value, often an option number or code value (e.g., 1, 2, A, B, true, false)."
        is part of identity
    shared string ResponseDescription
        documentation "Additional text provided to define the response value."
        is optional
    bool CorrectResponse
        documentation "Indicates the response is correct."
        is optional
