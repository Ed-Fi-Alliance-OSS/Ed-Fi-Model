Common GradePointAverage
    documentation "The grade point average for an individual computed as the grade points earned divided by the number of credits attempted."
    descriptor GradePointAverageType
        documentation "The system used for calculating the grade point average for an individual."
        is part of identity
    bool IsCumulative
        documentation "Indicator of whether or not the Grade Point Average value is cumulative."
        is optional
    shared decimal GPA named GradePointAverageValue
        documentation "The value of the grade points earned divided by the number of credits attempted."
        is required
    shared decimal GPA named MaxGradePointAverageValue
        documentation "The maximum value for the grade point average."
        is optional
