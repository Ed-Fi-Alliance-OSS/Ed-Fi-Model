Common AssessmentCustomization
    documentation "An un-typed key and value pair that is used to provide additional information needed for vendor regisration, administration, or reporting."
    string CustomizationKey
        documentation "An agreed upon identifier for the custom information."
        is part of identity
        max length 60
    string CustomizationValue
        documentation "Custom value for the indicated CustomizationKey."
        is required
        max length 1024