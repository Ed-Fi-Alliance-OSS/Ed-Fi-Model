Common RatingResult
    documentation "A rating or score for a level or topic of an evaluation."
    shared string RatingResultTitle
        documentation "The title of the rating result."
        is part of identity
    shared decimal NumericRating
        documentation "The numerical summary rating or score for the evaluation."
        is part of identity
    descriptor ResultDatatypeType
        documentation "The datatype of the rating result."
        is required
