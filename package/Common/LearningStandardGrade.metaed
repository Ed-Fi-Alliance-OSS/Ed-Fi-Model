Common LearningStandardGrade
    documentation "Learning standard for a grade."
    domain entity LearningStandard
        documentation "The learning standard associated with this grade."
        is part of identity
    shared string GradeEarned named LetterGradeEarned
        documentation "A final or interim (grading period) indicator of student performance for a learning standard as submitted by the instructor."
        is optional
    shared decimal NumericGrade named NumericGradeEarned
        documentation "A final or interim (grading period) indicator of student performance for a learning standard as submitted by the instructor."
        is optional
    shared string DiagnosticStatement
        documentation "A statement provided by the teacher that provides information in addition to the grade or assessment score."
        is optional
    descriptor PerformanceBaseConversion
        documentation "A performance level that describes the student proficiency."
        is optional
