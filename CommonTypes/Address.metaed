Common Type Address
    documentation 'The set of elements that describes an address, including the street address, 
                  'city, state, and ZIP code.
    string StreetNumberName
        documentation 'The street number and street name or post office box number of an address.
        is required
        min length 1
        max length 150
    string ApartmentRoomSuiteNumber
        documentation 'The apartment, room, or suite number of an address. 
        is optional
        min length 1
        max length 50
    string BuildingSiteNumber
        documentation 'The number of the building on the site, if more than one building shares the 
                      'same address.
        is optional
        min length 1
        max length 20
    shared string City named City
        documentation 'The name of the city in which an address is located. 
        is required
    enumeration StateAbbreviation
        documentation 'The abbreviation for the state (within the United States) or outlying area in 
                      'which an address is located. 
        is required
    string PostalCode
        documentation 'The five or nine digit zip code or overseas postal code portion of an address.
        is required
        min length 1
        max length 17
    string NameOfCounty
        documentation 'The name of the county, parish, borough, or comparable unit (within a state) in 
                      'which an address is located.
        is optional
        min length 1
        max length 30
    string CountyFIPSCode
        documentation 'The Federal Information Processing Standards (FIPS) numeric code for the county 
                      'issued by the National Institute of Standards and Technology (NIST). Counties 
                      'are considered to be the "first-order subdivisions" of each State and 
                      'statistically equivalent entity, regardless of their local designations (county, 
                      'parish, borough, etc.) Counties in different States will have the same code. A 
                      'unique county number is created when combined with the 2-digit FIPS State Code.
        is optional
        min length 3
        max length 5
    shared string Coordinate named Latitude
        documentation 'The geographic latitude of the physical address.
        is optional
    shared string Coordinate named Longitude
        documentation 'The geographic longitude of the physical address.
        is optional
    date BeginDate
        documentation 'The first date the address is valid. For physical addresses, the date 
                      'the person moved to that address.
        is optional
    date EndDate
        documentation 'The last date the address is valid. For physical addresses, this would be the date 
                      'the person moved from that address.
        is optional
    enumeration AddressType
        documentation 'The type of address listed for an individual or organization.    
                      'For example:  Physical Address, Mailing Address, Home Address, etc.)
        is part of identity