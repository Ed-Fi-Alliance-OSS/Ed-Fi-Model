Common Type ContentStandard
    documentation 'An indication as to whether an assessment conforms to a standard (e.g., local standard,
	'statewide standard, regional standard, association standard).
    '
    '...
    shared string ContentStandardTitle named Title
        documentation 'The name of the content standard, for example Common Core.
        is required
    string Author
        documentation 'The person or organization chiefly responsible for the intellectual content of 
        'the standard.
        is optional collection
        min length 1
        max length 255
    shared string ContentStandardVersion named Version
        documentation 'The version identifier for the content.
        is optional
    shared string URI named URI
        documentation 'An unambiguous reference to the standards using a network-resolvable URI.
        is optional
    include PublicationDateChoice
        documentation 'NEEDS DOCUMENTATION
        is optional
    enumeration PublicationStatus
        documentation 'The publication status of the document (i.e., Adopted, Draft, Published, 
		'Deprecated, Unknown).
        is optional
    reference EducationOrganization
        documentation 'Optionally relates the entity mandating the use of the content standard.
        is optional
        with context Mandating
    date BeginDate
        documentation 'The beginning of the period during which this learning standard document is intended 
        'for use.
        is optional
    date EndDate
        documentation 'The end of the period during which this learning standard document is intended 
        'for use.
        is optional

