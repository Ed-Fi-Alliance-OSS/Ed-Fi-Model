Common Type OtherName [518]
    documentation "Other names (e.g., alias, nickname, previous legal name) associated with a person."
    shared string PersonalTitlePrefix named PersonalTitlePrefix [887]
        documentation "A prefix used to denote the title, degree, position, or seniority of the person."
        is optional
    shared string FirstName named FirstName [882]
        documentation "A name given to an individual at birth, baptism, or during another naming ceremony, or through legal change."
        is required
    shared string MiddleName named MiddleName [885]
        documentation "A secondary name given to an individual at birth, baptism, or during another naming ceremony."
        is optional
    shared string LastSurname named LastSurname [884]
        documentation "The name borne in common by members of a family."
        is required
    shared string GenerationCodeSuffix named GenerationCodeSuffix [883]
        documentation "An appendage, if any, used to denote an individual's generation in his family (e.g., Jr., Sr., III)."
        is optional
    enumeration OtherNameType [886]
        documentation "The types of alternate names for a person."
        is part of identity