Domain Entity LearningObjective
    documentation 'This entity represents identified learning objectives for courses in specific 
                  'grades.
    shared string LearningStandardId named LearningObjectiveId
        documentation 'The identifier for the specific learning objective in the context of a 
                      'standard (e.g., 111.15.3.1.A).
        is optional
    include ContentStandard
        documentation 'A reference to the type of content standard (e.g., state, national)
        is optional
    string Objective
        documentation 'The designated title of the LearningObjective.
        is part of identity
        min length 1
        max length 60
    shared string Description named Description
        documentation 'The description of the LearningObjective.
        is optional
    descriptor AcademicSubject
        documentation 'The description of the content or subject area (e.g., arts, mathematics, 
                      'reading, stenography, or a foreign language) of an assessment.
        is part of identity
    descriptor GradeLevel
        documentation 'The grade level for which the LearningObjective is targeted.
        is part of identity
        with context Objective
    string Nomenclature
        documentation 'Reflects the specific nomenclature used for the LearningObjective.
        is optional
        min length 1
        max length 35
    string Criteria
        documentation 'One or more statements that describes the criteria used by teachers and students 
                      'to check for attainment of a learning objective. This criteria gives clear 
                      'indications as to the degree to which learning is moving through the Zone or 
                      'Proximal Development toward independent achievement of the LearningObjective.
        is optional
        with context Success
        min length 1
        max length 150
    reference LearningStandard
        documentation 'LearningStandard(s) included in this objective.
        is optional collection
    reference LearningObjective
        documentation 'Provide user information to lookup and link to an existing learning objective 
                      'which serves as a method to group other learning objectives.
        is optional
        with context Parent
    shared string URI named Namespace
        documentation 'Namespace for the LearningObjective.
        is required
