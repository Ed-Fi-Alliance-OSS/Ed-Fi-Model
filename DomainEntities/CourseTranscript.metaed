Domain Entity CourseTranscript [552]
    documentation 'This entity is the final record of a student's performance in their courses at 
                  'the end of a semester or school year.
    enumeration CourseAttemptResult [1319]
        documentation 'The result from the student's attempt to take the course, for example:
                      '
                      'Pass
                      '
                      'Fail
                      '
                      'Incomplete
                      '
                      'Withdrawn.
        is part of identity
    include Credits [1318]
        documentation 'The number of credits a student attempted and could earn for successfully 
                      'completing a given course.
        is optional
        with context Attempted
    include Credits [1324]
        documentation 'The number of credits a student earned for completing a given course.
        is required
        with context Earned
    include AdditionalCredits [1323]
        documentation 'The number of additional credits a student attempted and could earn for 
                      'successfully completing a given course (e.g., dual credit, AP, IB).
        is optional collection
        with context Earned
    descriptor GradeLevel [1328]
        documentation 'Student's grade level at time of course.
        is optional
        with context WhenTaken
    enumeration MethodCreditEarned [1331]
        documentation 'The method the credits were earned (e.g., Classroom, Examination, Transfer).
        is optional
    string GradeEarned [1326]
        documentation 'The final indicator of student performance in a class as submitted by the 
                      'instructor.
        is optional
        with context FinalLetter
        min length 1
        max length 20
    shared decimal NumericGrade named FinalNumericGradeEarned [1327]
        documentation 'The final indicator of student performance in a class as submitted by the 
                      'instructor.
        is optional
    enumeration CourseRepeatCode [1321]
        documentation 'Indicates that an academic course has been repeated by a student and how that 
                      'repeat is to be computed in the student's academic grade average.
        is optional
    reference Course [1320]
        documentation 'The course recorded in the course transcript entry.
        is part of identity
        with context Course
        is weak
    reference School [1332]
        documentation 'The School that provided the reported instruction.
        is optional
        is weak
    reference StudentAcademicRecord [1333]
        documentation 'Link to the student's academic record for a semester/school year.
        is part of identity
    string CourseTitle [1322]
        documentation 'The descriptive name given to a course of study offered in a school or other 
                      'institution or organization. In departmentalized classes at the elementary, 
                      'secondary, and postsecondary levels (and for staff development activities), 
                      'this refers to the name by which a course is identified (e.g., American History, 
                      'English III). For elementary and other non-departmentalized classes, it refers 
                      'to any portion of the instruction for which a grade or report is assigned (e.g., 
                      'reading, composition, spelling, language arts).
        is optional
        min length 1
        max length 60
    string CourseTitle [1330]
        documentation 'The descriptive name given to a course of study offered in the school, if 
                      'different from the CourseTitle. 
        is optional
        with context Alternative
        min length 1
        max length 60
    shared string LocalCourseCode named CourseCode [1329]
        documentation 'The local code assigned by the school that identifies the course offering, the code 
                      'from an external educational organization, or other alternate course code.
        is optional
        with context Alternative