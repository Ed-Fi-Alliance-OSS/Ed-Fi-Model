Inline Common Type Achievement
	documentation 'An entity that includes information about achievement earned by a learner upon 
	'fulfilling a specified criteria, which may be defined by a related competency 
	'set.
   string AchievementTitle
        documentation 'The title assigned to the Achievement.
        is optional
        min length 1
        max length 60
    descriptor AchievementCategory
        documentation 'The category of achievement attributed to the learner.
        is optional
    string AchievementCategorySystem
        documentation 'The system that defines the categories by which an achievement is attributed to 
        'the learner.
        is optional
        min length 1
        max length 60
    string IssuerName
        documentation 'The name of the agent, entity, or institution issuing the element.
        is optional
        min length 1
        max length 150
    shared string URI named IssuerOriginURL
        documentation 'The Uniform Resource Locator (URL) from which the award was issued.
        is optional
    string Criteria
        documentation 'The criteria for competency-based completion of the achievement/award.
        is optional
        min length 1
        max length 150
    shared string URI named CriteriaURL
        documentation 'The Uniform Resource Locator (URL) for the unique address of a web page 
        'describing the competency-based completion criteria for the achievement/award.
        is optional
    string Statement
        documentation 'A statement or reference describing the evidence that the learner met the 
		'criteria for attainment of the Achievement.
        is optional
        with context Evidence
        min length 1
        max length 150
    shared string URI named ImageURL
        documentation 'The Uniform Resource Locator (URL) for the unique address of an image 
		'representing an award or badge associated with the Achievement.
        is optional

