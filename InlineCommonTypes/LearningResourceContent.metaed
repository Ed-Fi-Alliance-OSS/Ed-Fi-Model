Inline Common Type LearningResourceContent
    documentation 'NEEDS DOCUMENTATION
    string ShortDescription
        documentation 'A short description or name of the entity.
        is required
        min length 1
        max length 75
    shared string Description named Description
        documentation 'An extended written representation of the education content.
        is optional
    string Author
        documentation 'The individual credited with the creation of the resource.
        is optional collection
        min length 1
        max length 255
    bool AdditionalAuthorsIndicator
        documentation 'Indicates whether there are additional un-named authors. In a research report, 
                      'this is often marked by the abbreviation "et al".
        is optional
    string Publisher
        documentation 'The organization credited with publishing the resource.
        is optional
        min length 1
        max length 50
    duration TimeRequired
        documentation 'Approximate or typical time it takes to work with or through this learning 
                      'resource for the typical intended target audience.
        is optional
    enumeration InteractivityStyle
        documentation 'The predominate mode of learning supported by the learning resource. Acceptable 
                      'values are active, expositive, or mixed.
        is optional
    enumeration ContentClass
        documentation 'The predominate type or kind characterizing the learning resource.
        is required
    string UseRightsURL
        documentation 'The URL where the owner specifies permissions for using the resource.
        is optional
        min length 5
        max length 255
    include EducationContentSource
        documentation 'A reference or URL pointing to education content from which this education 
                      'content was derived.
        is optional
        with context DerivativeSource
    include PublicationDateChoice
        documentation 'NEEDS DOCUMENTATION
        is optional
    enumeration Sex
        documentation 'Sexes for which this education content is applicable. If omitted, considered 
                      'generally applicable.
        is optional collection
        with context Appropriate
    descriptor GradeLevel
        documentation 'Grade levels for which this education content is applicable-if omitted, 
                      'considered generally applicable.
        is optional collection
        with context Appropriate
    descriptor Language
        documentation 'An indication of the languages in which the Education Content is designed.
        is optional collection
    shared string LearningResourceContentVersion named Version
        documentation 'The version identifier for the content.
        is optional
    reference LearningStandard
        documentation 'Relates the competency, learning standard, skill and/or text complexity to which 
                      'the learning resource is aligned.
        is optional