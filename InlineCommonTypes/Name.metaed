Inline Common Type Name [517]
    documentation 'The set of elements that comprise a person's legal name.
    string PersonalTitlePrefix [881]
        documentation 'A prefix used to denote the title, degree, position, or seniority of the person.
        is optional
        min length 1
        max length 30
    string FirstName [876]
        documentation 'A name given to an individual at birth, baptism, or during another naming 
                      'ceremony, or through legal change.
        is required
        min length 1
        max length 75
    string MiddleName [880]
        documentation 'A secondary name given to an individual at birth, baptism, or during another 
                      'naming ceremony.
        is optional
        min length 1
        max length 75
    shared string LastSurname named LastSurname [878]
        documentation 'The name borne in common by members of a family.
        is required
    string GenerationCodeSuffix [877]
        documentation 'An appendage, if any, used to denote an individual's generation in his family 
                      '(e.g., Jr., Sr., III).
        is optional
        min length 1
        max length 10
    shared string LastSurname named MaidenName [879]
        documentation 'The person's maiden name.
        is optional
    include IdentificationDocument [891]
        documentation 'The documents presented as evident to verify one's personal identity; for 
                      'example: drivers license, passport, birth certificate, etc.
        is optional collection
        with context Personal